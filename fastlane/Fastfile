default_platform(:ios)

BUNDLE_ID = "com.aelshal.iptvPlayer"
PROJECT = "ios/Runner.xcodeproj"
WORKSPACE = "ios/Runner.xcworkspace"

platform :ios do
  desc "Sign with the repo secrets and upload to TestFlight (run after `flutter build ios --no-codesign`)"
  lane :beta do
    setup_ci
    tmp = ENV.fetch("RUNNER_TEMP", "/tmp")
    team_id = ENV.fetch("APPLE_TEAM_ID")

    cert_path = File.join(tmp, "dist.p12")
    File.binwrite(cert_path, Base64.decode64(ENV.fetch("IOS_DIST_CERT_P12_BASE64")))
    import_certificate(
      certificate_path: cert_path,
      certificate_password: ENV.fetch("IOS_DIST_CERT_PASSWORD"),
      keychain_name: "fastlane_tmp_keychain",
      keychain_password: ""
    )

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true
    )
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)

    # Register the app ID the first time.
    if Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID).nil?
      Spaceship::ConnectAPI::BundleId.create(name: "IPTV Player", platform: "IOS", identifier: BUNDLE_ID)
      UI.success("Registered app ID #{BUNDLE_ID}")
    end

    # Provisioning profile: from the secret if given, otherwise made/fetched with the API key.
    profile_b64 = ENV["IOS_PROFILE_APP_BASE64"].to_s
    if profile_b64.empty?
      get_provisioning_profile(
        api_key: api_key,
        app_identifier: BUNDLE_ID,
        team_id: team_id,
        output_path: tmp,
        filename: "iptv.mobileprovision"
      )
      profile_path = File.join(tmp, "iptv.mobileprovision")
    else
      profile_path = File.join(tmp, "iptv.mobileprovision")
      File.binwrite(profile_path, Base64.decode64(profile_b64))
      install_provisioning_profile(path: profile_path)
    end
    profile_name = FastlaneCore::ProvisioningProfile.parse(profile_path)["Name"]

    update_code_signing_settings(
      path: PROJECT,
      targets: ["Runner"],
      use_automatic_signing: false,
      team_id: team_id,
      code_sign_identity: "Apple Distribution",
      profile_name: profile_name,
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      workspace: WORKSPACE,
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build",
      output_name: "IPTV-Player.ipa",
      xcargs: "DEVELOPMENT_TEAM=#{team_id}",
      export_options: { provisioningProfiles: { BUNDLE_ID => profile_name } }
    )

    if Spaceship::ConnectAPI::App.find(BUNDLE_ID).nil?
      UI.user_error!("No app for #{BUNDLE_ID} in App Store Connect yet. Create it (Apps → + → New App, bundle ID #{BUNDLE_ID}) and run the workflow again.")
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "build/IPTV-Player.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
